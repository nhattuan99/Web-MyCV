# ==============================================================================
# ENVIRONMENT: PRODUCTION
# ==============================================================================
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database Configuration (Separate Production Database)
DB_TYPE=sqlite
DB_PATH=../data/prod/cv_prod.sqlite

# Security & CORS (Whitelisted Production Domains)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://nhattuan-cv.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=60

# Application Metadata
APP_NAME=CV_Backend_PROD
APP_VERSION=1.0.0
LOG_LEVEL=info
ENABLE_TEST_TOOLS=false
ADMIN_SECRET_KEY=prod-secure-token-98fbc8d31a5e7
