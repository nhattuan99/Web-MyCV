# ==============================================================================
# ENVIRONMENT: UAT (User Acceptance Testing / Staging)
# ==============================================================================
NODE_ENV=uat
PORT=4001
HOST=0.0.0.0

# Database Configuration (Separate UAT Database)
DB_TYPE=sqlite
DB_PATH=../data/uat/cv_uat.sqlite

# Security & CORS (Whitelisted UAT Clients)
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Application Metadata
APP_NAME=CV_Backend_UAT
APP_VERSION=1.0.0-rc1
LOG_LEVEL=debug
ENABLE_TEST_TOOLS=true
ADMIN_SECRET_KEY=uat-admin-token-preview-2026
